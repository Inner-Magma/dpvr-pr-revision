# Copy to .env and fill in paths for your machine.
# All absolute paths in the codebase resolve from these roots.

# Root of raw datasets (e.g. LLaVA-1.5-665k JSON + images)
DATA_ROOT=/path/to/datasets

# Root of pretrained weights (Vicuna-7B, CLIP, LLaVA projector, packed HF LLaVA)
MODEL_ROOT=/path/to/models

# Output root for trained checkpoints + logs
CKPT_ROOT=/path/to/checkpoints

# Local clone of lmms-eval (required for evaluation phase)
LMMS_EVAL_PATH=/path/to/lmms-eval

# Optional: HF mirror endpoint (set to empty string to use default)
HF_ENDPOINT=https://hf-mirror.com
