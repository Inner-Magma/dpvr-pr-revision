# Copy to .env on the server and fill in. .env is gitignored: never commit it.
# All absolute paths in the codebase resolve from these roots.

# Root of raw datasets (LLaVA-1.5-665k JSON + images; benchmarks under benchmarks/)
DATA_ROOT=/path/to/datasets

# Root of pretrained weights (HF-format models; reference/ holds Vicuna + the
# stage-1 projector for check_weight_provenance.py only)
MODEL_ROOT=/path/to/models

# Output root for trained checkpoints, logs and revision_runs/
CKPT_ROOT=/path/to/checkpoints

# Optional: benchmark root (default ${DATA_ROOT}/benchmarks)
# BENCH_ROOT=/path/to/benchmarks

# Optional: HF mirror endpoint (empty = huggingface.co)
HF_ENDPOINT=https://hf-mirror.com

# Old hsf checkpoints relayed through a private Hugging Face repo (SERVER_HANDOFF §1.3)
# HF_TOKEN=
# HF_CKPT_REPO=<user>/<repo>      # a private model repo

# Result emails (scripts/revision/send_results.py). Use the mailbox's SMTP
# authorisation code / app password, not the login password.
#   QQ mail:  SMTP_HOST=smtp.qq.com    SMTP_PORT=465
#   163 mail: SMTP_HOST=smtp.163.com   SMTP_PORT=465
#   Gmail:    SMTP_HOST=smtp.gmail.com SMTP_PORT=465 (app password; often unreachable from mainland China)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
# MAIL_FROM=   (defaults to SMTP_USER)
